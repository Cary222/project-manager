generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["pm"]
}

enum UserRole {
  ROOT
  USER

  @@schema("pm")
}

enum ModerationAction {
  BAN_USER
  UNBAN_USER
  UPDATE_ROLE
  UPDATE_PROFILE
  UPDATE_PASSWORD
  UPDATE_SYSTEM_SETTINGS
  DELETE_TICKET
  CREATE_TICKET
  CREATE_MODULE
  UPDATE_MODULE
  DELETE_MODULE
  MERGE_MODULE
  CREATE_PROJECT
  DELETE_PROJECT
  UPDATE_TICKET_STATUS
  UPDATE_TICKET_ASSIGNEE
  UPDATE_TICKET_PROGRESS
  EDIT_TICKET
  CHANGE_TICKET_MODULE

  @@schema("pm")
}

enum ResponsibilityKind {
  PROGRAM
  DESIGN
  BUG

  @@schema("pm")
}

enum TicketStatus {
  DEVELOPING
  READY_FOR_TEST
  DELIVERED
  DONE
  OVERDUE
  CLOSED

  @@schema("pm")
}

enum NotificationType {
  TICKET_ASSIGNED
  TICKET_DELIVERED
  TICKET_COMPLETED
  TICKET_STATUS_CHANGED

  @@schema("pm")
}

model User {
  id                     String                  @id @default(cuid())
  name                   String?
  email                  String                  @unique
  emailVerified          DateTime?
  image                  String?
  passwordHash           String?
  role                   UserRole                @default(USER)
  bannedAt               DateTime?
  bio                    String?                 @db.Text
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  accounts               Account[]
  sessions               Session[]
  createdTickets         Ticket[]                @relation("TicketCreator")
  ticketAssignments      TicketAssignee[]
  assigneeHistoryChanges TicketAssigneeHistory[] @relation("AssigneeHistoryActor")
  statusHistoryChanges   TicketStatusHistory[]   @relation("StatusHistoryActor")
  moderationLogs         ModerationLog[]         @relation("ModerationActor")
  updatedSystemSettings  SystemSetting[]         @relation("SystemSettingUpdater")
  notifications          Notification[]          @relation("NotificationRecipient")
  actorNotifications     Notification[]          @relation("NotificationActor")
  pushRecords            DesignProgramBinding[]
  bugBindings            BugProgramBinding[]
  pkmNotes               PkmNote[]
  responsibilities       UserResponsibility[]
  userOnProjects         UserOnProject[]
  ownedProjects          Project[]

  aiConversations AiConversation[]
  aiProfile       AiUserProfile?
  weeklyReports   WeeklyReport[]

  @@schema("pm")
}

model UserOnProject {
  id        String   @id @default(cuid())
  userId    String
  projectId String
  role      String   @default("MEMBER")
  joinedAt  DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId])
  @@index([projectId])
  @@schema("pm")
}

model UserResponsibility {
  id        String             @id @default(cuid())
  userId    String
  kind      ResponsibilityKind
  createdAt DateTime           @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind])
  @@schema("pm")
}

model ModerationLog {
  id         String           @id @default(cuid())
  action     ModerationAction
  targetId   String
  targetType String
  reason     String?
  actorId    String
  createdAt  DateTime         @default(now())
  actor      User             @relation("ModerationActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([targetId])
  @@index([actorId, createdAt(sort: Desc)])
  @@schema("pm")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@schema("pm")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@schema("pm")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@schema("pm")
}

enum SearchDocumentSourceType {
  TICKET
  COMMIT
  KNOWLEDGE_DOC
  PKM_NOTE

  @@schema("pm")
}

model SearchDocument {
  id         String                        @id @default(cuid())
  sourceType SearchDocumentSourceType
  sourceId   String
  chunkIndex Int                           @default(0)
  projectId  String?
  title      String
  content    String
  url        String
  metadata   Json?
  embedding  Unsupported("public.vector")?
  createdAt  DateTime                      @default(now())
  updatedAt  DateTime                      @updatedAt
  project    Project?                      @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([sourceType, sourceId, chunkIndex])
  @@index([sourceType, updatedAt(sort: Desc)])
  @@index([projectId, updatedAt(sort: Desc)])
  @@schema("pm")
}

enum IndexJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED

  @@schema("pm")
}

model IndexJob {
  id           String         @id @default(cuid())
  noteId       String
  status       IndexJobStatus @default(PENDING)
  attempt      Int            @default(0)
  maxAttempts  Int            @default(5)
  error        String?
  errorSources Json?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  startedAt    DateTime?

  note PkmNote? @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@index([status, createdAt(sort: Asc)])
  @@index([noteId, status])
  @@schema("pm")
}

model PkmNote {
  id          String     @id @default(cuid())
  userId      String
  projectId   String?
  title       String
  content     String
  tags        String[]   @default([])
  attachments Json?
  isPublic    Boolean    @default(false)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  project     Project?   @relation(fields: [projectId], references: [id], onDelete: SetNull)
  indexJobs   IndexJob[]

  @@index([userId, updatedAt(sort: Desc)])
  @@index([userId, isPublic, updatedAt(sort: Desc)])
  @@index([projectId, updatedAt(sort: Desc)])
  @@index([isPublic, updatedAt(sort: Desc)])
  @@schema("pm")
}

model Project {
  id               String                @id @default(cuid())
  name             String
  description      String?
  status           String                @default("ACTIVE")
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  ownerId          String?
  owner            User?                 @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  members          UserOnProject[]
  responsibilities Responsibility[]
  tickets          Ticket[]
  searchDocuments  SearchDocument[]
  pkmNotes         PkmNote[]
  weeklyReports    WeeklyReportProject[]

  @@schema("pm")
}

model Responsibility {
  id        String             @id @default(cuid())
  projectId String
  kind      ResponsibilityKind
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  project   Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  modules   Module[]

  @@unique([projectId, kind])
  @@schema("pm")
}

model Module {
  id               String         @id @default(cuid())
  responsibilityId String
  name             String
  description      String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  responsibility   Responsibility @relation(fields: [responsibilityId], references: [id], onDelete: Cascade)
  tickets          Ticket[]

  @@unique([responsibilityId, name])
  @@schema("pm")
}

model Ticket {
  id              String                  @id @default(cuid())
  ticketNo        Int                     @unique
  title           String
  description     String?
  progress        Int                     @default(0)
  status          TicketStatus            @default(DEVELOPING)
  deadline        DateTime?
  projectId       String
  moduleId        String
  creatorId       String
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  project         Project                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  module          Module                  @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  creator         User                    @relation("TicketCreator", fields: [creatorId], references: [id], onDelete: Restrict)
  assignees       TicketAssignee[]
  repoBindings    TicketRepoBinding[]
  commits         TicketCommit[]
  assigneeHistory TicketAssigneeHistory[]
  statusHistory   TicketStatusHistory[]
  notifications   Notification[]
  pushSources     DesignProgramBinding[]  @relation("PushSourceTicket")
  pushTargets     DesignProgramBinding[]  @relation("PushTargetTicket")
  bugSources      BugProgramBinding[]     @relation("BugSourceTicket")
  bugTargets      BugProgramBinding[]     @relation("BugTargetTicket")

  @@index([status, deadline])
  @@schema("pm")
}

model DesignProgramBinding {
  id                 String   @id @default(cuid())
  sourceTicketId     String
  targetTicketId     String?
  createdById        String
  status             String
  errorMessage       String?
  draftTitle         String
  draftDescription   String?
  programAssigneeIds String[] @default([])
  designAssigneeIds  String[] @default([])
  bugCommitIds       String[] @default([])
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  sourceTicket       Ticket   @relation("PushSourceTicket", fields: [sourceTicketId], references: [id], onDelete: Cascade)
  targetTicket       Ticket?  @relation("PushTargetTicket", fields: [targetTicketId], references: [id], onDelete: SetNull)
  createdBy          User     @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([sourceTicketId])
  @@index([createdById, createdAt(sort: Desc)])
  @@schema("pm")
}

model BugProgramBinding {
  id              String   @id @default(cuid())
  bugTicketId     String
  programTicketId String
  draftTitle      String   @default("")
  fixCommitIds    String[] @default([])
  boundById       String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  bugTicket       Ticket   @relation("BugSourceTicket", fields: [bugTicketId], references: [id], onDelete: Cascade)
  programTicket   Ticket   @relation("BugTargetTicket", fields: [programTicketId], references: [id], onDelete: Cascade)
  boundBy         User     @relation(fields: [boundById], references: [id], onDelete: Restrict)

  @@unique([bugTicketId, programTicketId])
  @@index([programTicketId])
  @@index([bugTicketId])
  @@schema("pm")
}

model TicketAssignee {
  ticketId  String
  userId    String
  createdAt DateTime @default(now())
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([ticketId, userId])
  @@schema("pm")
}

model TicketStatusHistory {
  id          String       @id @default(cuid())
  ticketId    String
  status      TicketStatus
  changedById String
  createdAt   DateTime     @default(now())
  ticket      Ticket       @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  changedBy   User         @relation("StatusHistoryActor", fields: [changedById], references: [id], onDelete: Restrict)

  @@index([ticketId, createdAt(sort: Desc)])
  @@schema("pm")
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  content   String
  ticketId  String?
  actorId   String?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())
  user      User             @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  ticket    Ticket?          @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  actor     User?            @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([userId, read, createdAt(sort: Desc)])
  @@index([ticketId, createdAt(sort: Desc)])
  @@schema("pm")
}

model TicketAssigneeHistory {
  id          String   @id @default(cuid())
  ticketId    String
  assigneeIds String[] @default([])
  changedById String
  createdAt   DateTime @default(now())
  ticket      Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  changedBy   User     @relation("AssigneeHistoryActor", fields: [changedById], references: [id], onDelete: Restrict)

  @@index([ticketId, createdAt(sort: Desc)])
  @@schema("pm")
}

model TicketRepoBinding {
  id        String   @id @default(cuid())
  ticketId  String
  repoPath  String
  createdAt DateTime @default(now())
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@unique([ticketId, repoPath])
  @@index([repoPath])
  @@schema("pm")
}

model TicketCommit {
  id          String   @id @default(cuid())
  ticketId    String
  ticketNo    Int
  repoPath    String
  commitSha   String
  author      String
  committedAt DateTime
  subject     String
  branches    String[] @default([])
  createdAt   DateTime @default(now())
  ticket      Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@unique([repoPath, commitSha])
  @@index([ticketNo, committedAt(sort: Desc)])
  @@schema("pm")
}

model SyncCursor {
  id            String    @id @default(cuid())
  repoPath      String    @unique
  lastCommitAt  DateTime?
  lastCommitSha String?
  updatedAt     DateTime  @updatedAt

  @@schema("pm")
}

model Counter {
  key       String   @id
  nextValue Int
  updatedAt DateTime @updatedAt

  @@schema("pm")
}

model SystemSetting {
  id              String   @id @default(cuid())
  siteName        String   @default("ProjectHub")
  siteDescription String?
  logoUrl         String?
  welcomeMessage  String?
  updatedById     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  updatedBy       User?    @relation("SystemSettingUpdater", fields: [updatedById], references: [id], onDelete: SetNull)

  @@schema("pm")
}

/// 统一行为事件日志（Event Backbone v3）
/// 前端只负责发送原始事件，后端负责计算 isValidView。
/// Tier 3（通知/审计）已有独立系统，本表不承接。
model ActivityLog {
  id String @id @default(cuid())

  /// 事件协议版本（用于 schema 演进时兼容旧数据）
  eventVersion String @default("1.0")
  /// 动作类型（ACTION.*），冗余存储而非外键：避免枚举变更牵连历史
  action       String

  /// 执行者
  actorId   String
  actorName String?

  /// 目标
  targetType String?
  targetId   String?
  targetName String?

  /// 会话
  sessionId String?

  /// 原始上下文（前端上报的 dwellMs / enterAt / leaveAt 等）
  context Json?

  /// 后端计算字段（可信，前端不可干预）
  dwellMs     Int?
  /// dwellMs > 3000 的有效访问标记
  isValidView Boolean?

  /// 入库时间
  createdAt DateTime @default(now())

  @@index([action, createdAt(sort: Desc)])
  @@index([actorId, createdAt(sort: Desc)])
  @@index([targetType, targetId, createdAt(sort: Desc)])
  @@index([targetType, isValidView, createdAt(sort: Desc)])
  @@schema("pm")
}

model AiConversation {
  id            String   @id @default(cuid())
  userId        String
  title         String
  summary       Json?
  tags          String[] @default([])
  messageCount  Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  lastMessageAt DateTime @default(now())

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages AiChatMessage[]

  @@index([userId, lastMessageAt(sort: Desc)])
  @@schema("pm")
}

model AiChatMessage {
  id             String   @id @default(cuid())
  conversationId String
  role           String
  content        String   @db.Text
  sources        Json?
  createdAt      DateTime @default(now())

  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt(sort: Asc)])
  @@schema("pm")
}

model AiUserProfile {
  userId             String   @id
  profile            Json
  sourceSummaryCount Int      @default(0)
  updatedAt          DateTime @updatedAt
  createdAt          DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@schema("pm")
}

model WeeklyReport {
  id               String    @id @default(cuid())
  userId           String
  weekStart        DateTime
  weekEnd          DateTime
  title            String
  content          String    @db.Text
  attachments      Json?
  aiSummary        String?   @db.Text
  aiSummaryAt      DateTime?
  aiSummaryPartial Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user     User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  projects WeeklyReportProject[]

  @@unique([userId, weekStart])
  @@index([userId, weekStart(sort: Desc)])
  @@schema("pm")
}

model WeeklyReportProject {
  id        String @id @default(cuid())
  reportId  String
  projectId String

  report  WeeklyReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  project Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([reportId, projectId])
  @@index([projectId])
  @@schema("pm")
}

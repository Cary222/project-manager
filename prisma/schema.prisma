/// 用户自定义 API Key 存储表（加密存储）
/// SYSTEM ownerType 的记录 userId 为空，仅用于平台级凭证（如 Agnes）
model UserApiKey {
  id           String    @id @default(cuid())
  userId       String? // 普通用户为真实 userId；SYSTEM 凭证为空
  ownerType    String    @default("USER") // "SYSTEM" | "USER"
  transport    String    @default("direct") // "proxy" | "direct"
  apiFormat    String    @default("openai-chat") // "openai-chat" | "openai-responses" | "anthropic"
  provider     String // provider id，如 "deepseek", "agnes", "anthropic"
  name         String // 用户给这个 key 的命名
  baseURL      String? // 可选的 Base URL，不填则用 provider 默认值
  encryptedKey String // AES-256-GCM 加密后的 API Key（hex 编码）
  iv           String // 初始化向量（hex 编码，12 字节）
  authTag      String // 认证标签（hex 编码，16 字节）
  keyLast4     String // 明文后 4 位，用于 UI 显示（如 "sk-...abcd"）
  keyHash      String // SHA-256 hash，用于去重校验（hex 编码）
  lastUsedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime? // 软删除

  // SYSTEM 凭证没有对应的 User 记录，设为可选关系
  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  // 支持同一 provider 下多个 key，通过 (userId, provider, name) 唯一约束
  @@unique([userId, provider, name])
  @@index([userId, provider, deletedAt])
  @@index([keyHash])
  @@index([ownerType])
  @@schema("pm")
}

// ========== AI 生图异步任务系统 ==========

enum AiMessageExecutionStatus {
  COMPLETED
  QUEUED
  PROCESSING
  FAILED
  CANCELLED

  @@schema("pm")
}

enum BackgroundJobType {
  IMAGE_GENERATE
  DOCUMENT_INDEX
  TEXT_SUMMARY

  @@schema("pm")
}

enum BackgroundJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED

  @@schema("pm")
}

enum JobOutputStatus {
  PENDING
  GENERATING
  COMPLETED
  FAILED

  @@schema("pm")
}

enum AiAttachmentType {
  IMAGE
  FILE

  @@schema("pm")
}

enum AiFileStorageType {
  DATABASE
  OBJECT_STORAGE

  @@schema("pm")
}

model BackgroundJob {
  id             String              @id @default(cuid())
  type           BackgroundJobType
  status         BackgroundJobStatus @default(PENDING)
  payload        Json
  result         Json?
  errorMessage   String?
  correlationId  String?
  traceId        String?
  parentJobId    String?
  priority       Int                 @default(10)
  attempt        Int                 @default(0)
  nextRetryAt    DateTime?
  lockedBy       String?
  leaseExpiresAt DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([status, priority, createdAt])
  @@index([correlationId])
  @@index([traceId])
  @@schema("pm")
}

model JobOutput {
  id           String          @id @default(cuid())
  jobId        String
  sequence     Int
  status       JobOutputStatus @default(PENDING)
  fileAssetId  String?
  errorMessage String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  fileAsset AiFileAsset? @relation(fields: [fileAssetId], references: [id], onDelete: SetNull)

  @@unique([jobId, sequence])
  @@index([jobId])
  @@map("JobOutput")
  @@schema("pm")
}

model AiMessageAttachment {
  id          String           @id @default(cuid())
  messageId   String
  fileAssetId String
  jobOutputId String?          @unique
  type        AiAttachmentType
  createdAt   DateTime         @default(now())

  message   AiChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  fileAsset AiFileAsset   @relation(fields: [fileAssetId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@index([fileAssetId])
  @@map("AiMessageAttachment")
  @@schema("pm")
}

model AiFileAsset {
  id          String            @id @default(cuid())
  storageType AiFileStorageType @default(DATABASE)
  storageKey  String?
  checksum    String?
  size        Int?
  mimeType    String?
  bytes       Bytes?
  createdAt   DateTime          @default(now())

  attachments AiMessageAttachment[]
  outputs     JobOutput[]

  @@index([storageKey])
  @@index([checksum])
  @@map("AiFileAsset")
  @@schema("pm")
}

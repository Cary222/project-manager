generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["pm"]
}

model User {
  id                     String                  @id @default(cuid())
  name                   String?
  searchName             String? // 所有变体空格分隔，冗余存储避免运行时计算
  email                  String                  @unique
  emailVerified          DateTime?
  image                  String?
  passwordHash           String?
  role                   UserRole                @default(USER)
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  bannedAt               DateTime?
  bio                    String?
  preferredAiModel       String? // 用户偏好的 AI 模型，null 表示使用系统默认（Agnes）
  accounts               Account[]
  aiConversations        AiConversation[]
  aiProfile              AiUserProfile?
  bugBindings            BugProgramBinding[]
  pushRecords            DesignProgramBinding[]
  moderationLogs         ModerationLog[]         @relation("ModerationActor")
  actorNotifications     Notification[]          @relation("NotificationActor")
  notifications          Notification[]          @relation("NotificationRecipient")
  pkmNotes               PkmNote[]
  ownedProjects          Project[]
  sessions               Session[]
  updatedSystemSettings  SystemSetting[]         @relation("SystemSettingUpdater")
  createdTickets         Ticket[]                @relation("TicketCreator")
  ticketAssignments      TicketAssignee[]
  assigneeHistoryChanges TicketAssigneeHistory[] @relation("AssigneeHistoryActor")
  ticketComments         TicketComment[]         @relation("TicketCommentAuthor")
  statusHistoryChanges   TicketStatusHistory[]   @relation("StatusHistoryActor")
  userOnProjects         UserOnProject[]
  responsibilities       UserResponsibility[]
  uploadedFiles          FileAsset[]
  weeklyReports          WeeklyReport[]
  workflowRuns           WorkflowRun[]
  monthlyExpenses        MonthlyExpense[]
  expenseShares          ExpenseShare[]
  userApiKeys            UserApiKey[]

  @@schema("pm")
}

model UserOnProject {
  id        String   @id @default(cuid())
  userId    String
  projectId String
  role      String   @default("MEMBER")
  joinedAt  DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId])
  @@index([projectId])
  @@schema("pm")
}

model UserResponsibility {
  id        String             @id @default(cuid())
  userId    String
  kind      ResponsibilityKind
  createdAt DateTime           @default(now())
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind])
  @@schema("pm")
}

model ModerationLog {
  id         String           @id @default(cuid())
  action     ModerationAction
  targetId   String
  targetType String
  reason     String?
  actorId    String
  createdAt  DateTime         @default(now())
  actor      User             @relation("ModerationActor", fields: [actorId], references: [id])

  @@index([targetId])
  @@index([actorId, createdAt(sort: Desc)])
  @@schema("pm")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@schema("pm")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@schema("pm")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@schema("pm")
}

model SearchDocument {
  id         String                   @id @default(cuid())
  sourceType SearchDocumentSourceType
  sourceId   String
  projectId  String?
  title      String
  content    String
  url        String
  metadata   Json?
  createdAt  DateTime                 @default(now())
  updatedAt  DateTime                 @updatedAt
  embedding  Unsupported("vector")?
  chunkIndex Int                      @default(0)
  project    Project?                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// 结构化字段：关联 Document.id（而不是 FileAsset.id）
  /// 一个 Document 对应多个 SearchDocument chunk，因此不能唯一约束 documentId。
  /// PR11 清理旧 metadata.fileAssetId
  documentId String?
  document   Document?                @relation(fields: [documentId], references: [id], onDelete: SetNull)

  @@unique([sourceType, sourceId, chunkIndex])
  @@index([sourceType, updatedAt(sort: Desc)])
  @@index([projectId, updatedAt(sort: Desc)])
  @@index([documentId])
  @@schema("pm")
}

model IndexJob {
  id           String             @id @default(cuid())
  noteId       String?
  targetType   IndexJobTargetType
  targetId     String
  status       IndexJobStatus     @default(PENDING)
  attempt      Int                @default(0)
  maxAttempts  Int                @default(5)
  error        String?
  errorSources Json?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  startedAt    DateTime?

  @@index([targetType, targetId])
  @@index([status, createdAt(sort: Desc)])
  @@schema("pm")
}

model PkmNote {
  id          String   @id @default(cuid())
  userId      String
  projectId   String?
  title       String
  content     String
  tags        String[] @default([])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  attachments Json?
  isPublic    Boolean  @default(false)
  project     Project? @relation(fields: [projectId], references: [id])
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt(sort: Desc)])
  @@index([userId, isPublic, updatedAt(sort: Desc)])
  @@index([projectId, updatedAt(sort: Desc)])
  @@index([isPublic, updatedAt(sort: Desc)])
  @@schema("pm")
}

model Project {
  id               String                @id @default(cuid())
  name             String
  description      String?
  status           String                @default("ACTIVE")
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  ownerId          String?
  pkmNotes         PkmNote[]
  owner            User?                 @relation(fields: [ownerId], references: [id])
  responsibilities Responsibility[]
  searchDocuments  SearchDocument[]
  tickets          Ticket[]
  members          UserOnProject[]
  weeklyReports    WeeklyReportProject[]

  @@schema("pm")
}

model Responsibility {
  id        String             @id @default(cuid())
  projectId String
  kind      ResponsibilityKind
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  modules   Module[]
  project   Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, kind])
  @@schema("pm")
}

model Module {
  id               String         @id @default(cuid())
  responsibilityId String
  name             String
  description      String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  responsibility   Responsibility @relation(fields: [responsibilityId], references: [id], onDelete: Cascade)
  tickets          Ticket[]

  @@unique([responsibilityId, name])
  @@schema("pm")
}

model Ticket {
  id              String                  @id @default(cuid())
  ticketNo        Int                     @unique
  title           String
  description     String?
  progress        Int                     @default(0)
  projectId       String
  moduleId        String
  creatorId       String
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  status          TicketStatus            @default(DEVELOPING)
  deadline        DateTime?
  priority        Int                     @default(2)
  bugSources      BugProgramBinding[]     @relation("BugSourceTicket")
  bugTargets      BugProgramBinding[]     @relation("BugTargetTicket")
  pushSources     DesignProgramBinding?   @relation("PushSourceTicket")
  pushTargets     DesignProgramBinding[]  @relation("PushTargetTicket")
  notifications   Notification[]
  creator         User                    @relation("TicketCreator", fields: [creatorId], references: [id])
  module          Module                  @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  project         Project                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignees       TicketAssignee[]
  assigneeHistory TicketAssigneeHistory[]
  comments        TicketComment[]
  commits         TicketCommit[]
  repoBindings    TicketRepoBinding[]
  statusHistory   TicketStatusHistory[]

  @@index([status, deadline])
  @@schema("pm")
}

model TicketComment {
  id               String   @id @default(cuid())
  ticketId         String
  authorId         String
  content          String
  /// 用户在评论中用 @ 提到的人(userId 列表)。用于:1)发提及通知;2)防 XSS 渲染只允许在这里列出的用户
  mentionedUserIds String[] @default([])
  /// 评论附件（PR10 FileAttachment 格式），Json 类型
  attachments      Json     @default("[]")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  ticket           Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author           User     @relation("TicketCommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt(sort: Desc)])
  @@schema("pm")
}

model DesignProgramBinding {
  id                 String   @id @default(cuid())
  sourceTicketId     String   @unique
  targetTicketId     String?
  createdById        String
  status             String
  errorMessage       String?
  draftTitle         String
  draftDescription   String?
  programAssigneeIds String[] @default([])
  designAssigneeIds  String[] @default([])
  bugCommitIds       String[] @default([])
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  createdBy          User     @relation(fields: [createdById], references: [id])
  sourceTicket       Ticket   @relation("PushSourceTicket", fields: [sourceTicketId], references: [id], onDelete: Cascade)
  targetTicket       Ticket?  @relation("PushTargetTicket", fields: [targetTicketId], references: [id])

  @@index([createdById, createdAt(sort: Desc)])
  @@schema("pm")
}

model BugProgramBinding {
  id              String   @id @default(cuid())
  bugTicketId     String
  programTicketId String
  draftTitle      String   @default("")
  boundById       String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  fixCommitIds    String[] @default([])
  boundBy         User     @relation(fields: [boundById], references: [id])
  bugTicket       Ticket   @relation("BugSourceTicket", fields: [bugTicketId], references: [id], onDelete: Cascade)
  programTicket   Ticket   @relation("BugTargetTicket", fields: [programTicketId], references: [id], onDelete: Cascade)

  @@unique([bugTicketId, programTicketId])
  @@index([programTicketId])
  @@index([bugTicketId])
  @@schema("pm")
}

model TicketAssignee {
  ticketId  String
  userId    String
  createdAt DateTime @default(now())
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([ticketId, userId])
  @@schema("pm")
}

model TicketStatusHistory {
  id          String       @id @default(cuid())
  ticketId    String
  status      TicketStatus
  changedById String
  createdAt   DateTime     @default(now())
  changedBy   User         @relation("StatusHistoryActor", fields: [changedById], references: [id])
  ticket      Ticket       @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt(sort: Desc)])
  @@schema("pm")
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  content   String
  ticketId  String?
  actorId   String?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())
  actor     User?            @relation("NotificationActor", fields: [actorId], references: [id])
  ticket    Ticket?          @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user      User             @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read, createdAt(sort: Desc)])
  @@index([ticketId, createdAt(sort: Desc)])
  @@schema("pm")
}

model TicketAssigneeHistory {
  id          String   @id @default(cuid())
  ticketId    String
  changedById String
  createdAt   DateTime @default(now())
  assigneeIds String[] @default([])
  changedBy   User     @relation("AssigneeHistoryActor", fields: [changedById], references: [id])
  ticket      Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt(sort: Desc)])
  @@schema("pm")
}

model TicketRepoBinding {
  id        String   @id @default(cuid())
  ticketId  String
  repoPath  String
  createdAt DateTime @default(now())
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@unique([ticketId, repoPath])
  @@index([repoPath])
  @@schema("pm")
}

model TicketCommit {
  id          String   @id @default(cuid())
  ticketId    String
  ticketNo    Int
  repoPath    String
  commitSha   String
  author      String
  committedAt DateTime
  subject     String
  createdAt   DateTime @default(now())
  branches    String[] @default([])
  ticket      Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@unique([repoPath, commitSha])
  @@index([ticketNo, committedAt(sort: Desc)])
  @@schema("pm")
}

model SyncCursor {
  id            String    @id @default(cuid())
  repoPath      String    @unique
  lastCommitAt  DateTime?
  lastCommitSha String?
  updatedAt     DateTime  @updatedAt

  @@schema("pm")
}

model Counter {
  key       String   @id
  nextValue Int
  updatedAt DateTime @updatedAt

  @@schema("pm")
}

model SystemSetting {
  id              String   @id @default(cuid())
  siteName        String   @default("ProjectHub")
  siteDescription String?
  logoUrl         String?
  welcomeMessage  String?
  updatedById     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  updatedBy       User?    @relation("SystemSettingUpdater", fields: [updatedById], references: [id])

  @@schema("pm")
}

/// 统一行为事件日志（Event Backbone v3）
/// 前端只负责发送原始事件，后端负责计算 isValidView。
/// Tier 3（通知/审计）已有独立系统，本表不承接。
model ActivityLog {
  id           String   @id @default(cuid())
  /// 事件协议版本（用于 schema 演进时兼容旧数据）
  eventVersion String   @default("1.0")
  /// 动作类型（ACTION.*），冗余存储而非外键：避免枚举变更牵连历史
  action       String
  /// 执行者
  actorId      String
  actorName    String?
  /// 目标
  targetType   String?
  targetId     String?
  targetName   String?
  /// 会话
  sessionId    String?
  /// 原始上下文（前端上报的 dwellMs / enterAt / leaveAt 等）
  context      Json?
  /// 后端计算字段（可信，前端不可干预）
  dwellMs      Int?
  /// dwellMs > 3000 的有效访问标记
  isValidView  Boolean?
  /// 入库时间
  createdAt    DateTime @default(now())

  @@index([action, createdAt(sort: Desc)])
  @@index([actorId, createdAt(sort: Desc)])
  @@index([targetType, targetId, createdAt(sort: Desc)])
  @@index([targetType, isValidView, createdAt(sort: Desc)])
  @@schema("pm")
}

model AiConversation {
  id            String                      @id @default(cuid())
  userId        String
  title         String
  summary       Json?
  messageCount  Int                         @default(0)
  /// 对话分类：CHAT=普通对话，WORK=工作流触发对话
  category      String                      @default("CHAT")
  createdAt     DateTime                    @default(now())
  updatedAt     DateTime                    @updatedAt
  lastMessageAt DateTime                    @default(now())
  tags          String[]                    @default([])
  messages      AiChatMessage[]
  runtimeState  AiConversationRuntimeState?
  workflows     WorkflowRun[]
  user          User                        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, category, lastMessageAt(sort: Desc)])
  @@schema("pm")
}

model AiChatMessage {
  id              String                   @id @default(cuid())
  conversationId  String
  role            String
  content         String
  sources         Json?
  metadata        Json?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  executionStatus AiMessageExecutionStatus @default(COMPLETED)
  errorMessage    String?
  conversation    AiConversation           @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  attachments     AiMessageAttachment[]

  @@index([conversationId, createdAt])
  @@schema("pm")
}

model AiUserProfile {
  userId             String    @id
  profile            Json
  sourceSummaryCount Int       @default(0)
  version            Int       @default(1) // 版本号，每次更新递增
  weekStart          DateTime? // 当前版本对应的周开始日期
  updatedAt          DateTime  @updatedAt
  createdAt          DateTime  @default(now())
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@schema("pm")
}

model AiConversationRuntimeState {
  conversationId  String         @id
  humanState      Json?
  semanticContext Json?
  updatedAt       DateTime       @updatedAt
  conversation    AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@schema("pm")
}

model WeeklyReport {
  id               String                @id @default(cuid())
  userId           String
  weekStart        DateTime
  weekEnd          DateTime
  title            String
  content          String
  attachments      Json?
  aiSummary        String?
  aiSummaryAt      DateTime?
  aiSummaryPartial Boolean               @default(false)
  /// Workflow RUN id that produced this report (nullable, no FK — soft link)
  workflowRunId    String?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  user             User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  projects         WeeklyReportProject[]

  @@unique([userId, weekStart])
  @@index([userId, weekStart(sort: Desc)])
  @@index([workflowRunId])
  @@schema("pm")
}

/// Unified table for SCHEDULE + RUN (kind discriminator).
/// SCHEDULE rows hold cron + nextTriggerAt for restart compensation;
/// RUN rows hold threadId + status for a single workflow execution.
model WorkflowRun {
  id               String          @id @default(cuid())
  kind             String // SCHEDULE | RUN
  userId           String
  workflowType     String // e.g. "weekly_report"
  threadId         String? // RUN only — LangGraph thread_id
  status           String // pending | running | waiting_review | done | cancelled | error | paused
  cron             String? // SCHEDULE optional cron hint string
  nextTriggerAt    DateTime? // SCHEDULE — next fire time (restart compensation)
  metadata         Json?
  history          Json? // append-only { timestamp, event, payload }[]
  parentScheduleId String? // RUN → SCHEDULE id
  conversationId   String? // 关联的对话 ID（可选，软链接）
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation     AiConversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@index([userId, kind])
  @@index([nextTriggerAt])
  @@index([threadId])
  @@index([conversationId])
  @@schema("pm")
}

model WeeklyReportProject {
  id        String       @id @default(cuid())
  reportId  String
  projectId String
  project   Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  report    WeeklyReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@unique([reportId, projectId])
  @@index([projectId])
  @@schema("pm")
}

model MonthlyExpense {
  id          String         @id @default(cuid())
  userId      String // 创建者
  month       String // "YYYY-MM" 格式，如 "2026-07"
  expenseType ExpenseType
  customType  String? // 当 expenseType = OTHER 时使用
  amount      Float // 总金额
  description String
  attachments Json? // FileAttachment[]
  status      ExpenseStatus  @default(ACTIVE)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  shares      ExpenseShare[]

  @@index([userId, month(sort: Desc)])
  @@index([month(sort: Desc)])
  @@schema("pm")
}

/// 报销分摊记录
model ExpenseShare {
  id          String         @id @default(cuid())
  expenseId   String
  userId      String
  shareAmount Float // 该用户分摊的金额
  createdAt   DateTime       @default(now())
  expense     MonthlyExpense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([expenseId, userId])
  @@index([userId, createdAt(sort: Desc)])
  @@schema("pm")
}

/// 用户上传的图片/文件二进制，存 DB 不落本地文件系统。
/// URL 由 `/api/upload/[id]` 代理返回；这样多实例部署不需要共享磁盘。
model FileAsset {
  id           String          @id @default(cuid())
  uploaderId   String
  originalName String
  mimeType     String
  size         Int
  bytes        Bytes
  /// sha256 hex (64 字符)，服务端权威计算，客户端 hash 仅作 hint
  hash         String?
  status       FileAssetStatus @default(ACTIVE)
  createdAt    DateTime        @default(now())
  uploader     User            @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
  /// Document 是 FileAsset 的派生（1:1），FileAsset 删除时级联删除 Document
  document     Document?
  /// FileReference 反向引用：FileAsset 被哪些业务实体引用
  references   FileReference[]

  @@unique([hash, size])
  @@index([uploaderId, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@map("UploadedFile")
  @@schema("pm")
}

/// 文件引用关系表（唯一权威来源）。
/// 所有"业务实体引用了哪些文件"的查询都从这张表读。
/// 业务实体的 attachments Json 仍保留作为前端序列化快照（向前兼容），PR11 切换读路径。
model FileReference {
  id          String                  @id @default(cuid())
  fileAssetId String
  sourceType  FileReferenceSourceType
  sourceId    String
  /// 软删除（PR10 Schema 先预留字段，hook 留 PR11 实现）
  deletedAt   DateTime?
  createdAt   DateTime                @default(now())

  fileAsset FileAsset @relation(fields: [fileAssetId], references: [id], onDelete: Cascade)

  @@unique([fileAssetId, sourceType, sourceId])
  @@index([sourceType, sourceId])
  @@index([fileAssetId])
  @@index([fileAssetId, deletedAt])
  @@schema("pm")
}

/// 文档处理层：FileAsset 的派生（1:1），存文本提取/chunk/embeddings 结果
model Document {
  id              String           @id @default(cuid())
  /// 关联 FileAsset（1:1）。FileAsset 删除时级联删除 Document。
  fileAssetId     String           @unique
  fileAsset       FileAsset        @relation(fields: [fileAssetId], references: [id], onDelete: Cascade)
  status          DocumentStatus   @default(PENDING)
  /// 版本号，PR11 实现重处理时递增
  version         Int              @default(1)
  /// chunk 缓存（量小保留，PR11 可剥）
  extractedText   String?
  pageCount       Int?
  /// OCR / PDF 解析的扩展信息
  metadata        Json?
  /// 失败时的错误信息
  error           Json?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  /// 反向 relation：SearchDocument.documentId → Document
  searchDocuments SearchDocument[]

  @@index([status, updatedAt(sort: Desc)])
  @@index([fileAssetId])
  @@schema("pm")
}

enum UserRole {
  ROOT
  USER

  @@schema("pm")
}

enum ModerationAction {
  BAN_USER
  UNBAN_USER
  UPDATE_ROLE
  DELETE_TICKET
  CREATE_TICKET
  CREATE_MODULE
  UPDATE_MODULE
  DELETE_MODULE
  MERGE_MODULE
  CREATE_PROJECT
  DELETE_PROJECT
  UPDATE_TICKET_STATUS

# 使用独立 schema（pm）避免与 community 公共表冲突
DATABASE_URL="postgresql://community:community@192.168.1.14:5432/community?schema=pm"
AUTH_SECRET="replace-with-a-long-random-secret"
AUTH_TRUST_HOST=true
NEXTAUTH_SECRET="replace-with-a-long-random-secret"
# NEXTAUTH_URL 设置为 localhost，避免 0.0.0.0 被用于 redirect URL
NEXTAUTH_URL=http://localhost:3003

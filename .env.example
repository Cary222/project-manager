# Database
# 使用 pm 作为默认 schema，并显式保留 public 在 search_path 中，确保 pgvector 类型与操作符可见
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB?options=-c%20search_path%3Dpm,public"

# Auth
AUTH_SECRET="replace-with-a-long-random-secret"
NEXTAUTH_SECRET="replace-with-a-long-random-secret"

# NextAuth
AUTH_TRUST_HOST=true

# NEXTAUTH_URL:
# - local: http://localhost:3003
# - prod:  https://your-domain.com
# NEXTAUTH_URL 设置为 localhost，避免 0.0.0.0 被用于 redirect URL
NEXTAUTH_URL=http://localhost:3003

# Embedding API（本地 BGE-M3 模型，FastAPI 监听 0.0.0.0:5000）
# 远程机器访问时改为 http://<服务器IP>:5000
EMBEDDING_API_URL=http://localhost:5000
EMBEDDING_DIMENSIONS=1024
EMBEDDING_TIMEOUT_MS=30000

# Agnes API
# ─────────────────────────────────────────────────────────────────────────────
# Agnes API (https://apihub.agnes-ai.com) is blocked by GFW in mainland China.
#
# Development (your Mac): use HTTP_PROXY to route via local VPN/proxy (e.g. Clash Verge).
# Production (server in China): set AGNES_API_URL to the CF Worker URL instead.
#
# Local dev (no change needed — HTTP_PROXY below already routes Agnes via your VPN):
#   AGNES_API_URL=https://apihub.agnes-ai.com/v1
#   HTTP_PROXY=http://127.0.0.1:7890
#   HTTPS_PROXY=http://127.0.0.1:7890
#
# Production (server in China, no VPN):
#   AGNES_API_URL=https://project-manager-agnes-proxy.<YOUR_ACCOUNT>.workers.dev/v1
#   (Do NOT set HTTP_PROXY on the server — CF Worker URL is publicly reachable)
# ─────────────────────────────────────────────────────────────────────────────
AGNES_API_URL=https://apihub.agnes-ai.com/v1
HTTP_PROXY=http://127.0.0.1:7890
HTTPS_PROXY=http://127.0.0.1:7890

# Tavily Search (AI 联网搜索)
TAVILY_API_KEY=tvly-your-key-here

# ─────────────────────────────────────────────────────────────────────────────
# Encryption Key for User API Key Storage
# Required for encrypting user-provided API keys (AES-256-GCM)
# Generate a 32-byte (64 hex characters) random key:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ─────────────────────────────────────────────────────────────────────────────
ENCRYPTION_KEY=your-32-byte-hex-key-here

# ~/.config/systemd/user/project-manager-background-worker.service
#
# 安装步骤：
#   1. 把这份文件放到目标机器的 ~/.config/systemd/user/project-manager-background-worker.service
#      （按需替换 WorkingDirectory / ExecStart / EnvironmentFile 路径）
#   2. systemctl --user daemon-reload
#   3. systemctl --user enable --now project-manager-background-worker.service
#   4. 验证：systemctl --user status project-manager-background-worker.service
#   5. 看日志：journalctl --user -u project-manager-background-worker.service -f
#
# 注意事项：
#   - 这是 user-level unit（不用 sudo）
#   - 与 project-manager-worker.service (IndexJob) 平行运行，操作不同的表（BackgroundJob）
#   - Restart=always + RestartSec=5：worker 崩溃自动重启
#   - 和 Next.js 同样读 .env.production

[Unit]
Description=project-manager Background Worker (AI 生图 / 异步任务)
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/hxy/work/personal/project-manager
Environment=NODE_ENV=production
EnvironmentFile=/home/hxy/work/personal/project-manager/.env.production
ExecStart=/home/hxy/work/personal/project-manager/node_modules/.bin/tsx worker/background/index.ts
Restart=always
RestartSec=5

# 日志转 journald（journalctl --user -u project-manager-background-worker -f 查看）
StandardOutput=journal
StandardError=journal
SyslogIdentifier=project-manager-background-worker

[Install]
WantedBy=default.target
